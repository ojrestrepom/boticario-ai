# Variables de la guía docs/deploy/cloud-run.md (preparación única en Google Cloud).
# Copia este archivo a .env.cloud-run (ignorado por git), edita los dos primeros valores y cárgalo con:
#   source .env.cloud-run
# desde la raíz del repo, en cada terminal nueva. No contiene secretos.

# Edita estos dos valores.
PROJECT_ID="boticario-ai-CAMBIAME"   # único en todo Google Cloud: 6-30 caracteres, minúsculas, dígitos y guiones; elige un sufijo propio
BILLING_ACCOUNT_ID="XXXXXX-XXXXXX-XXXXXX"   # sale de: gcloud billing accounts list

# Valores propuestos, coherentes con el diseño del cambio.
REGION="northamerica-south1"
REPO="boticario"                 # repositorio Docker de Artifact Registry
SERVICE="boticario-api"          # servicio de Cloud Run
DEPLOYER_SA="boticario-deployer"
RUNTIME_SA="boticario-runtime"
POOL="github"
PROVIDER="boticario-ai"
GITHUB_REPO="sebastianrodriguez1115/boticario-ai"
SECRET_NAME="boticario-api-tokens"   # secreto de Secret Manager con los tokens de API (paso 7); debe coincidir con --set-secrets de .github/workflows/deploy-backend.yml

# Importe del presupuesto (paso 5): debe ir en la moneda de la cuenta de facturación.
# Mírala con: gcloud billing accounts describe "$BILLING_ACCOUNT_ID" --format='value(currencyCode)'
# 5000COP es el equivalente aproximado a 1 USD para una cuenta en pesos colombianos.
# Si la cuenta está en otra moneda, pon el equivalente a 1 USD en esa moneda, por ejemplo BUDGET_AMOUNT="1USD".
BUDGET_AMOUNT="5000COP"

# Derivados.
DEPLOYER_EMAIL="$DEPLOYER_SA@$PROJECT_ID.iam.gserviceaccount.com"
RUNTIME_EMAIL="$RUNTIME_SA@$PROJECT_ID.iam.gserviceaccount.com"

# Queda vacío hasta que el proyecto exista (paso 1 de la guía); entonces basta volver a hacer source.
PROJECT_NUMBER="$(gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)' 2>/dev/null)"
