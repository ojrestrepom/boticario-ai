{
  "openapi": "3.1.0",
  "info": {
    "title": "Boticario AI Catalog API",
    "description": "API de solo lectura del catálogo de plantas y sus fuentes. Dentro de `/v1` solo habrá cambios aditivos: los clientes deben ignorar los campos desconocidos. Las rutas desconocidas responden 404 y los métodos distintos de `GET` responden 405, ambos como `application/problem+json`.",
    "license": {
      "name": ""
    },
    "version": "1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "El servicio está activo.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "El servicio está activo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Documento OpenAPI de esta misma API.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "Este mismo documento OpenAPI",
            "content": {
              "application/json": {}
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plants": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Lista plantas con búsqueda y paginación.",
        "operationId": "list_plants",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Subcadena a buscar en el nombre científico y los nombres comunes, sin distinguir mayúsculas, acentos ni espacios repetidos o exteriores. Vacío o solo espacios no filtra; `%` y `_` se buscan como texto literal. No admite caracteres de control.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Elementos por página (1 a 100, por defecto 20).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Elementos a saltar (por defecto 0).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de plantas en orden de nombre científico e identificador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageDto_PlantSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Parámetro inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plants/{id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Detalle de una planta con la fuente de cada dato.",
        "operationId": "get_plant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador público de la planta, por ejemplo `lavandula-angustifolia`.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la planta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantDto"
                }
              }
            }
          },
          "400": {
            "description": "Identificador no válido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "404": {
            "description": "La planta no existe",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Fuentes de datos del catálogo.",
        "operationId": "sources",
        "responses": {
          "200": {
            "description": "Fuentes del catálogo, ordenadas por identificador",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceDto"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommonNameDto": {
        "type": "object",
        "description": "Nombre común con su idioma, dentro del listado.",
        "required": [
          "text",
          "language"
        ],
        "properties": {
          "language": {
            "type": "string",
            "description": "Código de idioma."
          },
          "text": {
            "type": "string",
            "description": "Texto del nombre."
          }
        }
      },
      "FamilyDto": {
        "type": "object",
        "description": "Valor único (familia) con la fuente elegida.",
        "required": [
          "value",
          "sources"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fuentes que la aportan."
          },
          "value": {
            "type": "string",
            "description": "Nombre de la familia."
          }
        }
      },
      "HealthDto": {
        "type": "object",
        "description": "Respuesta de `GET /healthz`.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Siempre `\"ok\"` si el servicio está activo."
          }
        }
      },
      "NameDto": {
        "type": "object",
        "description": "Nombre de planta con su atribución. Los campos van planos (no anidados en `value`) para que el JSON sea más directo.",
        "required": [
          "text",
          "kind",
          "language",
          "sources"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/NameKindDto",
            "description": "Tipo de nombre."
          },
          "language": {
            "type": "string",
            "description": "Código de idioma."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fuentes que lo aportan."
          },
          "text": {
            "type": "string",
            "description": "Texto del nombre."
          }
        }
      },
      "NameKindDto": {
        "type": "string",
        "description": "Tipo de nombre, serializado como `\"scientific\"` o `\"common\"`.",
        "enum": [
          "scientific",
          "common"
        ]
      },
      "PageDto_PlantSummaryDto": {
        "type": "object",
        "description": "Página de resultados.\n\nEs genérica: `T` es el tipo de elemento. Con `T: Serialize` el `derive` de serde genera la serialización de `PageDto<T>` para cualquier `T` serializable.",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Elemento del listado de plantas.",
              "required": [
                "id",
                "scientificName",
                "commonNames"
              ],
              "properties": {
                "commonNames": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommonNameDto"
                  },
                  "description": "Nombres comunes con su idioma."
                },
                "family": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Familia, o `null` si ninguna fuente la aporta."
                },
                "id": {
                  "type": "string",
                  "description": "Identificador público."
                },
                "scientificName": {
                  "type": "string",
                  "description": "Nombre científico canónico."
                }
              }
            },
            "description": "Elementos de la página."
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Límite aplicado.",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "description": "Desplazamiento aplicado.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total de coincidencias, independiente de la página.",
            "minimum": 0
          }
        }
      },
      "PartDto": {
        "type": "object",
        "description": "Parte de la planta con su atribución.",
        "required": [
          "label",
          "sources"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Etiqueta de la parte."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fuentes que la aportan."
          }
        }
      },
      "PlantDto": {
        "type": "object",
        "description": "Detalle completo de una planta.",
        "required": [
          "id",
          "scientificName",
          "names",
          "parts",
          "uses"
        ],
        "properties": {
          "family": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FamilyDto",
                "description": "Familia, o `null`."
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string",
            "description": "Identificador público."
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NameDto"
            },
            "description": "Nombres de la planta."
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartDto"
            },
            "description": "Partes de la planta."
          },
          "scientificName": {
            "type": "string",
            "description": "Nombre científico canónico."
          },
          "uses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UseDto"
            },
            "description": "Usos de la planta."
          }
        }
      },
      "PlantSummaryDto": {
        "type": "object",
        "description": "Elemento del listado de plantas.",
        "required": [
          "id",
          "scientificName",
          "commonNames"
        ],
        "properties": {
          "commonNames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommonNameDto"
            },
            "description": "Nombres comunes con su idioma."
          },
          "family": {
            "type": [
              "string",
              "null"
            ],
            "description": "Familia, o `null` si ninguna fuente la aporta."
          },
          "id": {
            "type": "string",
            "description": "Identificador público."
          },
          "scientificName": {
            "type": "string",
            "description": "Nombre científico canónico."
          }
        }
      },
      "ProblemDto": {
        "type": "object",
        "description": "Cuerpo de error `application/problem+json` (RFC 9457).",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Explicación específica de esta ocurrencia; en los 500 es siempre genérica."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ruta pedida, cuando aplica."
          },
          "param": {
            "type": [
              "string",
              "null"
            ],
            "description": "Parámetro afectado, en los errores 400 (extensión de RFC 9457)."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Código de estado HTTP.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Resumen corto del problema (el texto estándar del código HTTP)."
          },
          "type": {
            "type": "string",
            "description": "URI que identifica el tipo de problema; siempre `about:blank`."
          }
        }
      },
      "ReferenceDto": {
        "type": "object",
        "description": "Referencia bibliográfica de un uso.",
        "required": [
          "id",
          "citation"
        ],
        "properties": {
          "citation": {
            "type": "string",
            "description": "Cita completa."
          },
          "id": {
            "type": "string",
            "description": "Identificador de la referencia."
          }
        }
      },
      "SourceDto": {
        "type": "object",
        "description": "Una fuente de datos.\n\n`checksum` es un campo adicional al mínimo que exige la spec (id, nombre, versión, licencia, cita y URL): permite verificar de qué insumo viene el catálogo.",
        "required": [
          "id",
          "name",
          "version",
          "license",
          "citation",
          "url",
          "checksum"
        ],
        "properties": {
          "checksum": {
            "type": "string",
            "description": "Checksum del insumo original."
          },
          "citation": {
            "type": "string",
            "description": "Cita recomendada."
          },
          "id": {
            "type": "string",
            "description": "Identificador de la fuente."
          },
          "license": {
            "type": "string",
            "description": "Licencia."
          },
          "name": {
            "type": "string",
            "description": "Nombre legible."
          },
          "url": {
            "type": "string",
            "description": "URL de origen."
          },
          "version": {
            "type": "string",
            "description": "Versión del dataset."
          }
        }
      },
      "UseDto": {
        "type": "object",
        "description": "Uso de la planta con su referencia y atribución.",
        "required": [
          "activity",
          "language",
          "reference",
          "sources"
        ],
        "properties": {
          "activity": {
            "type": "string",
            "description": "Actividad atribuida."
          },
          "language": {
            "type": "string",
            "description": "Idioma de la etiqueta de actividad."
          },
          "reference": {
            "$ref": "#/components/schemas/ReferenceDto",
            "description": "Referencia que respalda el uso."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fuentes que lo aportan."
          }
        }
      }
    }
  }
}
