{
  "openapi": "3.1.0",
  "info": {
    "title": "Boticario AI Catalog API",
    "description": "API de solo lectura del catálogo de plantas. Dentro de `/v1` solo habrá cambios aditivos: los clientes deben ignorar los campos desconocidos. Las rutas desconocidas responden 404 y los métodos distintos de `GET` responden 405, ambos como `application/problem+json`.",
    "license": {
      "name": ""
    },
    "version": "1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "El servicio está activo.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "El servicio está activo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Documento OpenAPI de esta misma API.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "Este mismo documento OpenAPI",
            "content": {
              "application/json": {}
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plants": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Lista plantas con búsqueda y paginación.",
        "operationId": "list_plants",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Subcadena a buscar en el nombre científico y los nombres comunes, sin distinguir mayúsculas, acentos ni espacios repetidos o exteriores. Vacío o solo espacios no filtra; `%` y `_` se buscan como texto literal. No admite caracteres de control.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Elementos por página (1 a 100, por defecto 20).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Elementos a saltar (por defecto 0).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de plantas en orden de nombre científico e identificador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageDto_PlantSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Parámetro inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token de API o no es válido",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Siempre `Bearer`"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/plants/{id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Detalle de una planta.",
        "operationId": "get_plant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador público de la planta, por ejemplo `lavandula-angustifolia`.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la planta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantDto"
                }
              }
            }
          },
          "400": {
            "description": "Identificador no válido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token de API o no es válido",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Siempre `Bearer`"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "404": {
            "description": "La planta no existe",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido; la respuesta incluye `Allow: GET`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CommonNameDto": {
        "type": "object",
        "description": "Nombre común con su idioma, dentro del listado.",
        "required": [
          "text",
          "language"
        ],
        "properties": {
          "language": {
            "type": "string",
            "description": "Código de idioma."
          },
          "text": {
            "type": "string",
            "description": "Texto del nombre."
          }
        }
      },
      "GoalDto": {
        "type": "object",
        "description": "Objetivo registrado para la planta.",
        "required": [
          "id",
          "name",
          "subarea",
          "area",
          "evidence",
          "references"
        ],
        "properties": {
          "area": {
            "type": "string",
            "description": "Área, en español."
          },
          "evidence": {
            "type": "string",
            "description": "Tipo de respaldo, en español."
          },
          "id": {
            "type": "string",
            "description": "Identificador del objetivo."
          },
          "name": {
            "type": "string",
            "description": "Nombre del objetivo, en español."
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceDto"
            },
            "description": "Referencias que respaldan el objetivo."
          },
          "subarea": {
            "type": [
              "string",
              "null"
            ],
            "description": "Subárea (solo en «otros objetivos»), o `null`."
          }
        }
      },
      "HealthDto": {
        "type": "object",
        "description": "Respuesta de `GET /health`.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Siempre `\"ok\"` si el servicio está activo."
          }
        }
      },
      "ImageDto": {
        "type": "object",
        "description": "Imagen de la planta con su licencia. La API solo entrega los datos del registro: nunca sirve los bytes de la imagen.",
        "required": [
          "url",
          "pageUrl",
          "author",
          "license",
          "licenseUrl",
          "attributionRequired"
        ],
        "properties": {
          "attributionRequired": {
            "type": "boolean",
            "description": "Si hay que mostrar la atribución al usar la imagen."
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "description": "Autor, o `null` si no se conoce."
          },
          "license": {
            "type": "string",
            "description": "Licencia de la imagen."
          },
          "licenseUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL de la licencia, o `null` si no existe."
          },
          "pageUrl": {
            "type": "string",
            "description": "Página del archivo de la imagen."
          },
          "url": {
            "type": "string",
            "description": "URL de la imagen."
          }
        }
      },
      "NameDto": {
        "type": "object",
        "description": "Nombre de planta con su tipo e idioma.",
        "required": [
          "text",
          "kind",
          "language"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/NameKindDto",
            "description": "Tipo de nombre."
          },
          "language": {
            "type": "string",
            "description": "Código de idioma."
          },
          "text": {
            "type": "string",
            "description": "Texto del nombre."
          }
        }
      },
      "NameKindDto": {
        "type": "string",
        "description": "Tipo de nombre, serializado como `\"scientific\"` o `\"common\"`.",
        "enum": [
          "scientific",
          "common"
        ]
      },
      "OilDto": {
        "type": "object",
        "description": "Aceite de la planta.",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo de aceite, por ejemplo `Esencial`."
          }
        }
      },
      "PageDto_PlantSummaryDto": {
        "type": "object",
        "description": "Página de resultados.\n\nEs genérica: `T` es el tipo de elemento. Con `T: Serialize` el `derive` de serde genera la serialización de `PageDto<T>` para cualquier `T` serializable.",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Elemento del listado de plantas.",
              "required": [
                "id",
                "scientificName",
                "displayName",
                "commonNames"
              ],
              "properties": {
                "commonNames": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommonNameDto"
                  },
                  "description": "Nombres comunes con su idioma; si el nombre para mostrar es uno de ellos, va primero."
                },
                "displayName": {
                  "type": "string",
                  "description": "Nombre para mostrar: un nombre común en español o, si la planta no tiene ninguno, el nombre científico."
                },
                "family": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Familia, o `null` si ninguna fuente la aporta."
                },
                "id": {
                  "type": "string",
                  "description": "Identificador público."
                },
                "scientificName": {
                  "type": "string",
                  "description": "Nombre científico canónico."
                }
              }
            },
            "description": "Elementos de la página."
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Límite aplicado.",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "description": "Desplazamiento aplicado.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total de coincidencias, independiente de la página.",
            "minimum": 0
          }
        }
      },
      "PartDto": {
        "type": "object",
        "description": "Parte de la planta.",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Etiqueta de la parte."
          }
        }
      },
      "PlantDto": {
        "type": "object",
        "description": "Detalle completo de una planta.\n\nLos campos consolidados están siempre presentes: con `null` o lista vacía cuando la planta no tiene el dato.",
        "required": [
          "id",
          "scientificName",
          "displayName",
          "names",
          "parts",
          "uses",
          "synonyms",
          "description",
          "origin",
          "oil",
          "useGroups",
          "goals",
          "safety",
          "image"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Descripción neutra, o `null`."
          },
          "displayName": {
            "type": "string",
            "description": "Nombre para mostrar: un nombre común en español o, si la planta no tiene ninguno, el nombre científico."
          },
          "family": {
            "type": [
              "string",
              "null"
            ],
            "description": "Familia, o `null` si ninguna fuente la aporta."
          },
          "goals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalDto"
            },
            "description": "Objetivos registrados, por nombre."
          },
          "id": {
            "type": "string",
            "description": "Identificador público."
          },
          "image": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ImageDto",
                "description": "Imagen con su licencia, o `null`."
              },
              {
                "type": "null"
              }
            ]
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NameDto"
            },
            "description": "Nombres de la planta."
          },
          "oil": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OilDto",
                "description": "Aceite de la planta, o `null`."
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": [
              "string",
              "null"
            ],
            "description": "Origen, o `null`."
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartDto"
            },
            "description": "Partes de la planta."
          },
          "safety": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SafetyDto",
                "description": "Precauciones, o `null` solo cuando no hay ningún dato (lo que no significa que la planta sea segura)."
              },
              {
                "type": "null"
              }
            ]
          },
          "scientificName": {
            "type": "string",
            "description": "Nombre científico canónico."
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Nombres científicos distintos del aceptado, ordenados por texto."
          },
          "useGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UseGroupDto"
            },
            "description": "Grupos de uso tradicional, por número de registros descendente y actividad, con la cita completa."
          },
          "uses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UseDto"
            },
            "description": "Usos de la planta (una fila por referencia resuelta); su cita es la etiqueta de la referencia."
          }
        }
      },
      "PlantSummaryDto": {
        "type": "object",
        "description": "Elemento del listado de plantas.",
        "required": [
          "id",
          "scientificName",
          "displayName",
          "commonNames"
        ],
        "properties": {
          "commonNames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommonNameDto"
            },
            "description": "Nombres comunes con su idioma; si el nombre para mostrar es uno de ellos, va primero."
          },
          "displayName": {
            "type": "string",
            "description": "Nombre para mostrar: un nombre común en español o, si la planta no tiene ninguno, el nombre científico."
          },
          "family": {
            "type": [
              "string",
              "null"
            ],
            "description": "Familia, o `null` si ninguna fuente la aporta."
          },
          "id": {
            "type": "string",
            "description": "Identificador público."
          },
          "scientificName": {
            "type": "string",
            "description": "Nombre científico canónico."
          }
        }
      },
      "ProblemDto": {
        "type": "object",
        "description": "Cuerpo de error `application/problem+json` (RFC 9457).",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Explicación específica de esta ocurrencia; en los 500 es siempre genérica."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ruta pedida, cuando aplica."
          },
          "param": {
            "type": [
              "string",
              "null"
            ],
            "description": "Parámetro afectado, en los errores 400 (extensión de RFC 9457)."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Código de estado HTTP.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Resumen corto del problema (el texto estándar del código HTTP)."
          },
          "type": {
            "type": "string",
            "description": "URI que identifica el tipo de problema; siempre `about:blank`."
          }
        }
      },
      "ReferenceDto": {
        "type": "object",
        "description": "Referencia bibliográfica de un uso.",
        "required": [
          "id",
          "citation"
        ],
        "properties": {
          "citation": {
            "type": "string",
            "description": "Cita completa."
          },
          "id": {
            "type": "string",
            "description": "Identificador de la referencia."
          }
        }
      },
      "SafetyDto": {
        "type": "object",
        "description": "Precauciones de la planta. Su ausencia (`null`) significa que no hay ningún dato, no que la planta sea segura.",
        "required": [
          "level",
          "text",
          "references"
        ],
        "properties": {
          "level": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SafetyLevelDto",
                "description": "Nivel, o `null` si las fuentes traen advertencias pero ninguna fija un nivel."
              },
              {
                "type": "null"
              }
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceDto"
            },
            "description": "Referencias que respaldan el texto."
          },
          "text": {
            "type": "string",
            "description": "Texto de las advertencias."
          }
        }
      },
      "SafetyLevelDto": {
        "type": "string",
        "description": "Nivel de precaución, serializado como `\"alto\"`, `\"medio\"` o `\"bajo\"`.",
        "enum": [
          "alto",
          "medio",
          "bajo"
        ]
      },
      "UseDto": {
        "type": "object",
        "description": "Uso de la planta con su referencia.",
        "required": [
          "activity",
          "language",
          "reference"
        ],
        "properties": {
          "activity": {
            "type": "string",
            "description": "Actividad atribuida."
          },
          "language": {
            "type": "string",
            "description": "Idioma de la etiqueta de actividad."
          },
          "reference": {
            "$ref": "#/components/schemas/ReferenceDto",
            "description": "Referencia que respalda el uso."
          }
        }
      },
      "UseGroupDto": {
        "type": "object",
        "description": "Grupo de uso tradicional: una actividad con el número de registros, los países y sus citas.",
        "required": [
          "activity",
          "activitySource",
          "count",
          "countries",
          "references"
        ],
        "properties": {
          "activity": {
            "type": "string",
            "description": "Actividad, en español."
          },
          "activitySource": {
            "type": "string",
            "description": "Actividad tal como la trae la fuente original."
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Número de registros que respaldan el grupo.",
            "minimum": 0
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Países, en español."
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UseGroupReferenceDto"
            },
            "description": "Citas del grupo, resueltas o no."
          }
        }
      },
      "UseGroupReferenceDto": {
        "type": "object",
        "description": "Cita de un grupo de uso: el texto completo de la cita, resuelta o no.",
        "required": [
          "id",
          "citation",
          "resolved"
        ],
        "properties": {
          "citation": {
            "type": "string",
            "description": "Texto completo de la cita; en una cita sin resolver, la clave seguida de «(sin resolver)»."
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Identificador de la referencia, o `null` si la cita no tiene una obra identificada."
          },
          "resolved": {
            "type": "boolean",
            "description": "Si la cita tiene una obra identificada."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de API en la cabecera `Authorization: Bearer <token>`. Es una credencial de acceso compartida por la app: no identifica a usuarios."
      }
    }
  }
}
