  "reviewFlags": [
    {
      "code": "objetivos-omitidos-por-toxicidad",
      "message": "TPPT marca la planta como de toxicidad humana fuerte; se omiten los objetivos que la EMA le asigna (cansancio y fatiga, cuidado de la piel).",
      "target": "goals"
    }
  ],
  "safety": {
    "level": "alto",
    "refs": [
      "tppt_plant:P239",
      "efsa_botanic:1246",
