  "reviewFlags": [
    {
      "code": "aceite-por-compuesto-eo",
      "message": "El aceite esencial se deduce solo del compuesto EO de USDA en la raíz, sin ficha aetheroleum de la EMA ni otra fuente; queda para revisión futura.",
