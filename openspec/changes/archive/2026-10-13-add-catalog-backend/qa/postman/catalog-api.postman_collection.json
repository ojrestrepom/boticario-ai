    {
      "name": "API-001 GET /healthz",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"content-type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json\"));",
              "pm.test(\"status ok\", () => { const j = pm.response.json(); pm.expect(j.status === \"ok\").to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "healthz"
          ],
          "query": []
        }
      }
    },
