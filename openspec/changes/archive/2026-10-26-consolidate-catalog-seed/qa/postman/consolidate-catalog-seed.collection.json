      "type": "text/javascript",
      "exec": [
       "const schema = {\"type\": \"object\", \"required\": [\"items\", \"total\", \"limit\", \"offset\"], \"properties\": {\"items\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"id\", \"scientificName\", \"commonNames\"], \"properties\": {\"commonNames\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"text\", \"language\"], \"properties\": {\"language\": {\"type\": \"string\"}, \"text\": {\"type\": \"string\"}}}}, \"family\": {\"type\": [\"string\", \"null\"]}, \"id\": {\"type\": \"string\"}, \"scientificName\": {\"type\": \"string\"}}}}, \"limit\": {\"type\": \"integer\", \"minimum\": 0}, \"offset\": {\"type\": \"integer\", \"minimum\": 0}, \"total\": {\"type\": \"integer\", \"minimum\": 0}}};",
       "pm.test(\"estado 200\", () => pm.response.to.have.status(200));",
       "pm.test(\"content-type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
       "pm.test(\"cumple el esquema de backend/openapi.json\", () => pm.response.to.have.jsonSchema(schema));",
       "const j = pm.response.json();",
       "pm.test(\"total 2354, limit 20, offset 0\", () => { pm.expect(j.total).to.eql(2354); pm.expect(j.limit).to.eql(20); pm.expect(j.offset).to.eql(0); pm.expect(j.items.length).to.eql(20); });"
